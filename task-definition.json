{
  "family": "studentperformance",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::342374576645:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "studentperformance",
      "image": "nginx",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}